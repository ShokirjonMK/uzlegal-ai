# UzLegal-AI muhit o'zgaruvchilari
#
# Nusxa oling va to'ldiring:   cp .env.example .env
# `.env` fayli `.gitignore` da — u hech qachon repoga tushmaydi.
#
# QOIDA: sirlar hech qachon kodda yoki `configs/*.yaml` da saqlanmaydi
# (docs/10-security-compliance.md § 4). Faqat env yoki secret manager.

# ── Profil ─────────────────────────────────────────────────────────────
UZLEGAL_PROFILE=local-dev
# UZLEGAL_LOG_LEVEL=INFO
# UZLEGAL_API_HOST=127.0.0.1
# UZLEGAL_API_PORT=8080

# ── LLM server (MLX bo'lmagan platformalar uchun asosiy yo'l) ──────────
# OpenAI-mos endpoint: Ollama, vLLM, LM Studio yoki o'z serveringiz.
# Model katalogida `backend: openai` bo'lgan yozuvlar shuni ishlatadi.
#
#   Ollama    http://localhost:11434/v1   (standart)
#   vLLM      http://localhost:8000/v1
#   O'z serveri  https://gpu.example.uz/v1
# UZLEGAL_OPENAI_ENDPOINT=http://localhost:11434/v1
# Ollama kalit talab qilmaydi; vLLM va bulut endpointlari uchun kerak.
# UZLEGAL_OPENAI_API_KEY=

# ── Embedding qurilmasi ────────────────────────────────────────────────
# Standart holda avtomatik tanlanadi: `cuda` → `mps` → `cpu`.
# Majburlash kerak bo'ladigan ikki holat:
#   1. GPU xotirasi LLM bilan bo'lishilsa (8 GB VRAM da 12B model +
#      embedder birga sig'maydi) — `cpu` ga o'ting;
#   2. Metal konteksti band bo'lsa (ikkita indeks bir vaqtda qurilsa)
#      torch cheksiz kutadi.
# UZLEGAL_EMBED_DEVICE=cpu

# ── API kirish nazorati ────────────────────────────────────────────────
# ADMIN KALITI — `/v1/admin/*` uchun. PROFILDAN QAT'IY NAZAR majburiy.
# Sozlanmagan bo'lsa admin endpointlari 503 qaytaradi (ochiq QOLMAYDI).
# Kuchli tasodifiy qiymat qo'ying:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
UZLEGAL_ADMIN_KEY=

# Foydalanuvchi yozuvisiz ishlaydigan statik kalitlar (vergul bilan).
# Integratsiya va monitoring uchun. Reja limitlari qo'llanmaydi.
# UZLEGAL_API_KEYS=

# Kirish siyosati profildan o'qiladi (`configs/profiles/*.yaml` → api.auth):
#   local-dev → none · server → api_key
# Shu yerdan majburlash mumkin:
# UZLEGAL_API_AUTH=api_key

# ── Telegram bot ───────────────────────────────────────────────────────
# Token @BotFather dan olinadi. Oshkor bo'lsa darhol /revoke qiling —
# token bilan bot nomidan xabar yuborish mumkin.
UZLEGAL_TELEGRAM_BOT_TOKEN=
# Hisobot va ogohlantirishlar yuboriladigan chat (shaxsiy yoki guruh)
UZLEGAL_TELEGRAM_CHAT_ID=
# Bot javob beradigan chatlar; bo'sh bo'lsa hammasi (vergul bilan)
# UZLEGAL_TELEGRAM_ALLOWED_CHATS=

# ── API kalitlari (server profili) ─────────────────────────────────────
# UZLEGAL_API_KEYS=

# ── Sintetik data generatsiyasi (Faza 3) ───────────────────────────────
# ANTHROPIC_API_KEY=
# HF_TOKEN=
