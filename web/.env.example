# ── uzlegal-ai yadrosi (savol-javob shu yerdan keladi) ─────────────────────
# Yadro manzili. Standart: http://localhost:8080
# Ishga tushirish (repo ildizida): make serve  yoki  uvicorn uzlegal.api.app:app
UZLEGAL_API_URL=http://localhost:8080
# Yadro himoyalangan boʻlsa — kalit. Aks holda boʻsh qoldiring.
UZLEGAL_API_KEY=
# Rejim: auto | simple | standard | complex. Standart: auto
UZLEGAL_MODE=
# Javobni kutish muddati (ms). Standart: 180000 (complex rejim ~45 s oladi)
UZLEGAL_TIMEOUT_MS=

# ── Anthropic (ENDI KERAK EMAS) ────────────────────────────────────────────
# Standart holda BARCHA model chaqiruvlari yadro orqali ketadi
# (AI_LOWYER_PROVIDER=uzlegal). Ya'ni:
#   · maʼlumot bulutga chiqmaydi;
#   · toʻlov yoʻq (bulut API da bitta savol ≈ $0.22);
#   · model tanlovi bitta joyda — configs/models.yaml.
#
# Bu kalit faqat AI_LOWYER_PROVIDER=anthropic aniq koʻrsatilganda kerak.
# ANTHROPIC_API_KEY=

# ── Model sozlamalari (ixtiyoriy) ──────────────────────────────────────────
# Asosiy model. Standart: claude-opus-5
AI_LOWYER_MODEL=claude-opus-5
# Fikrlash chuqurligi: low | medium | high | xhigh | max. Standart: high
AI_LOWYER_EFFORT=high
# Standart til: uz | ru | en | auto. Standart: auto (foydalanuvchi tilini aniqlaydi)
AI_LOWYER_LANG=auto
# Standart yozuv: latn | cyrl | auto. Standart: auto (savol yozuviga moslashadi)
AI_LOWYER_SCRIPT=auto

# ── Qonun bazasi (RAG) ─────────────────────────────────────────────────────
# Embedding provayderi: voyage | local. Standart: voyage agar VOYAGE_API_KEY boʻlsa, aks holda local.
# `local` — tashqi xizmatsiz ishlaydigan zaxira (sifati pastroq, faqat sinov uchun).
EMBEDDING_PROVIDER=
# Voyage AI kaliti — https://voyageai.com (Anthropic tavsiya qiladigan embedding provayderi)
VOYAGE_API_KEY=
VOYAGE_MODEL=voyage-3-large

# SQLite vektor bazasi fayli
CORPUS_DB_PATH=./data/corpus.db
# Qonun matnlari joylashgan papka (ingest uchun)
CORPUS_DIR=./data/corpus

# ── Telegram bot (ixtiyoriy) ───────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
# Super admin chat ID — statistika va bildirishnomalar shu chatga keladi.
# Bir nechta admin: vergul bilan ajrating (813225336,987654321).
# Oʻz ID'ingizni bilish uchun botga /id yozing.
ADMIN_CHAT_ID=
# Webhook'ni himoyalash uchun maxfiy token (oʻzingiz oʻylab toping)
TELEGRAM_WEBHOOK_SECRET=
# Ilovangizning ommaviy manzili, masalan https://ai-lowyer.example.com
PUBLIC_BASE_URL=

# ── API himoyasi (ixtiyoriy) ───────────────────────────────────────────────
# Agar toʻldirilsa, /api/* soʻrovlari `Authorization: Bearer <kalit>` talab qiladi.
API_KEY=

# ── Web admin panel (/admin) ───────────────────────────────────────────────
# Panel paroli. Boʻsh boʻlsa /admin BUTUNLAY yopiq turadi (himoyasiz ochilmaydi).
ADMIN_PASSWORD=
# Sessiya cookie'sini imzolash siri — uzun va tasodifiy boʻlsin.
# Yaratish quyidagi buyruq bilan (bu kod, oʻzbek matni emas):
# lint-uz-ignore
# node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
ADMIN_SESSION_SECRET=
# Sessiya muddati, soatda. Standart: 12
ADMIN_SESSION_HOURS=
# Telegram Login Widget uchun bot foydalanuvchi nomi (@ belgisisiz).
TELEGRAM_BOT_USERNAME=

# ── MongoDB (kabinet, yozishmalar tarixi, statistika) ──────────────────────
# Boʻsh boʻlsa kabinet va yozishmalar tarixi oʻchadi, qolgan hammasi ishlayveradi.
# Lokal: mongodb://127.0.0.1:27017
MONGODB_URI=
# Baza nomi. Standart: ai_lowyer
MONGODB_DB=

# ── Model provayderi ───────────────────────────────────────────────────────
# uzlegal | ollama | anthropic. Boʻsh boʻlsa — `uzlegal` (STANDART).
#
#   uzlegal    Model yadro orqali (POST /v1/generate). TAVSIYA ETILADI:
#              model tanlovi bitta joyda va maʼlumot chetga chiqmaydi.
#   ollama     Toʻgʻridan-toʻgʻri lokal Ollama. Yadrosiz ishlaydi, lekin
#              yadro qaysi modelni ishlatayotganini BILMAYDI — bir savolga
#              ikki xil javob chiqishi mumkin.
#   anthropic  Bulut. Kalit talab qiladi, pullik, maʼlumot chetga chiqadi.
AI_LOWYER_PROVIDER=
# Lokal model manzili. Docker ichidan xostdagi Ollama ga murojaat qilinsa:
# http://host.docker.internal:11434
OLLAMA_BASE_URL=
# Lokal model nomi. Standart: qwen2.5:7b-instruct
# Yuklab olish: ollama pull qwen2.5:7b-instruct
OLLAMA_MODEL=
# Qidiruv natijasi shu balldan past boʻlsa manba sifatida berilmaydi (0–1).
# Past qiymat — nomuvofiq boʻlaklar ham "huquqiy asos" sifatida uzatiladi va
# model javob toʻqishga moyil boʻladi. Standart: 0.4
# Haqiqiy korpus yuklangach qayta kalibrlang: mos savollar ballari bilan
# bazada javobi yoʻq savollar ballari orasidagi boʻshliqning oʻrtasi.
RAG_MIN_SCORE=
# Lokal model chiqishining qatʼiy chegarasi (token). Standart: 2048
OLLAMA_MAX_OUTPUT=
# Lokal model kontekst oynasi (token). Standart: 16384
OLLAMA_CONTEXT=
