{
  "name": "ai-lowyer",
  "version": "0.1.0",
  "private": true,
  "description": "AI Lawyer — yuridik savol-javob, qonun bazasi (RAG), hujjat tahlili va hujjat generatsiyasi. Web + REST API + Telegram bot + CLI, bitta loyihada.",
  "engines": {
    "node": ">=22.5.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "cli": "tsx src/cli.ts",
    "ingest": "tsx src/cli.ts ingest",
    "bot:set-webhook": "tsx scripts/set-webhook.ts",
    "bot:poll": "tsx scripts/bot-poll.ts",
    "lint:uz": "tsx scripts/lint-uz.mts",
    "check": "npm run typecheck && npm run lint:uz",
    "report": "tsx scripts/tg-report.mts",
    "docker:up": "docker compose up -d --build",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f",
    "docker:ingest": "docker compose exec web npm run ingest",
    "docker:holat": "docker compose ps",
    "verify:audit": "tsx scripts/verify-audit.mts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.116.0",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-tabs": "^1.1.21",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "docx": "^9.5.1",
    "grammy": "^1.38.2",
    "lucide-react": "^1.31.0",
    "mammoth": "^1.11.0",
    "mongodb": "^6.21.0",
    "next": "^15.5.4",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "tailwind-merge": "^3.6.0",
    "unpdf": "^1.3.2",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^22.18.8",
    "@types/react": "^19.1.16",
    "@types/react-dom": "^19.1.9",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  }
}
