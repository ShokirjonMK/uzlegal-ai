# Model fayllari va bilim bazasi — S3 / LFS da, repoda emas
models/
kb/
data/raw/
data/processed/
*.safetensors
*.gguf
*.npz
*.bin

# Adapterlar — Git LFS orqali (registry.yaml repoda qoladi)
adapters/**/*.safetensors
adapters/**/*.npz

# Trace va audit
data/traces.db
*.jsonl.gz
reports/*.html

# Foydalanuvchi bazasi — API kalit xeshlari va foydalanish tarixi.
# `data/traces.db` sanab o'tilgan edi, `users.db` esa yo'q edi: u
# `uzlegal serve` birinchi ishga tushishida o'zi yaratiladi va
# tasodifan commitga tushib ketishi mumkin edi.
data/users.db
data/*.db

# Mashinaga xos ishlash holati.
#
# Bular ilgari kuzatilardi va bu chalg'itardi: `sync-state.json` toza
# klonda ham «kb_version: v2026.08.10, oxirgi sync bo'lgan» deb turardi,
# holbuki o'sha mashinada indeks umuman yo'q edi. `/v1/health` aynan shu
# fayldan o'qigani uchun bo'sh tizimni «tayyor» deb ko'rsatardi.
#
# `runtime-state.json` esa qaysi model FAQAT SHU mashinada faol ekanini
# saqlaydi — uni ulashish ma'nosiz.
#
# Ikkalasi ham yo'q bo'lsa kod standart qiymatlardan boshlaydi.
data/runtime-state.json
data/sync-state.json

# Shaxsiy konfiguratsiya
configs/local.yaml
.env
.env.*
!.env.example

